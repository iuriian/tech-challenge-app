# PostgreSQL Configuration
POSTGRES_DB=oficina
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Auth Provider (emissor dos tokens; JWKS em ${AUTH_ISSUER_URI}/.well-known/jwks.json)
AUTH_ISSUER_URI=http://localhost:8081
AUTH_AUDIENCE=oficina

# Docker/CI
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
COMPOSE_VERSION=2.0